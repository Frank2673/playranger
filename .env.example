# PlayRanger 环境变量配置模板
# 复制此文件为 .env 并填入真实值

# ─── LLM 配置（文字规划用） ───
# 支持 OpenAI 兼容接口（魔搭 / DeepSeek / 智谱 / 通义 / OneAPI 等）
LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=sk-你的key
LLM_MODEL=qwen-max-latest
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048

# ─── VLM 配置（视觉理解用，可与 LLM 同一个） ───
VLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
VLM_API_KEY=sk-你的key
VLM_MODEL=qwen-vl-max-latest

# ─── 浏览器配置 ───
# 如果 Playwright 默认 chromium 启动不了，可以手动指定路径
# PLAYWRIGHT_CHROMIUM_PATH=C:\\path\\to\\chrome.exe

# ─── 试玩测试控制台 ───
# SQLite 路径（默认 output/platform.db）
# PLAYRANGER_DB_PATH=output/platform.db
# 任务输出根目录（默认 output/tasks）
# PLAYRANGER_TASKS_DIR=output/tasks
# 修复沙箱根目录（默认 output/fix_sandbox）
# PLAYRANGER_SANDBOX_ROOT=output/fix_sandbox
# 允许校验/修复的源码根目录（分号分隔；默认当前目录与项目根）
# PLAYRANGER_WORKSPACE_ROOTS=E:\\games\\my-game;E:\\games\\another
# 单任务内存预算 MB / 系统预留 GB（并发推荐公式参数）
# PLAYRANGER_PER_WORKER_MB=1536
# PLAYRANGER_RESERVE_GB=2.0
# 并发硬上限（默认 8，允许 1-32）
# PLAYRANGER_MAX_WORKERS=8
# 无头模式与步骤截图（默认 1）
# PLAYRANGER_HEADLESS=1
# PLAYRANGER_CAPTURE_SCREENSHOTS=1

# ─── 游戏目标 ───
# 默认测试目标，可以被 API 参数覆盖
DEFAULT_GAME_URL=
DEFAULT_GAME_GOAL=完成所有关卡并找到所有缺陷
